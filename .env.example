# ==============================================================================
# House Price Intelligence & Prediction Platform - Environment Configuration
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# --- Backend Service Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="House Price Intelligence Platform"

# --- Database Configuration (PostgreSQL) ---
# For local Windows PostgreSQL or Docker PostgreSQL:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=house_price_db

# Full SQLAlchemy Connection URL (asyncpg for async, psycopg2 for sync migrations)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/house_price_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/house_price_db

# --- Machine Learning & Model Registry ---
MODEL_REGISTRY_DIR=ml/models
ACTIVE_MODEL_VERSION=v1.0.0
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# --- Frontend Configuration ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Real Estate Price Intelligence"

# --- CORS Settings ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
